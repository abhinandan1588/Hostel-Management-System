# Local development environment. Not for production use.
# This file is gitignored; .env.example is the committed template.

FLASK_ENV=development
FLASK_APP=run.py

SECRET_KEY=dev-local-secret-change-me-8d3f1a9c4b7e2056
JWT_SECRET_KEY=dev-local-jwt-secret-change-me-51c8b0e7a4d9

# Local SQLite by default. Point at PostgreSQL when you have one running:
# DATABASE_URL=postgresql+psycopg://hms_user:hms_password@localhost:5432/hostel_db
DATABASE_URL=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_BASE_URL=http://localhost:5173

STORAGE_BACKEND=local
MAX_CONTENT_LENGTH=8388608

MAIL_ENABLED=false
MAIL_SUPPRESS_SEND=true

RATELIMIT_ENABLED=true
AUTH_RATELIMIT=30 per minute
