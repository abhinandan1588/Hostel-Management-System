# ---------------------------------------------------------------------------
# Hostel Management System - backend environment template
# Copy to .env and fill in real values. Never commit .env.
#
# On Render these are set as service environment variables instead; see
# render.yaml and docs/DEPLOY_RENDER.md.
# ---------------------------------------------------------------------------

# development | testing | production
FLASK_ENV=development
FLASK_APP=run.py

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# In production both must be at least 32 characters and must not be the
# placeholder values below, or the app refuses to start.
SECRET_KEY=replace-with-a-long-random-value
JWT_SECRET_KEY=replace-with-a-different-long-random-value

# --- Database --------------------------------------------------------------
# PostgreSQL (production). psycopg 3 driver:
# DATABASE_URL=postgresql+psycopg://hms_user:password@localhost:5432/hostel_db
# Plain postgres:// / postgresql:// URLs are auto-upgraded to psycopg.
# Leave unset to use the local SQLite file backend/hostel.db.
DATABASE_URL=
TEST_DATABASE_URL=sqlite:///:memory:
# Per-worker connection pool. Total connections to the database are
# WEB_CONCURRENCY x (DB_POOL_SIZE + DB_MAX_OVERFLOW); keep that under the
# limit of your Postgres plan. Production defaults to 5 + 5.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# SQLite is blocked in production because a container filesystem is ephemeral.
# Set to true only if you know the file lives on a persistent volume.
ALLOW_SQLITE_IN_PRODUCTION=false

# --- JWT -------------------------------------------------------------------
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=30

# --- CORS (comma separated frontend origins) -------------------------------
# Required in production - an empty list blocks the browser frontend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_BASE_URL=http://localhost:5173

# --- Uploads ---------------------------------------------------------------
# local | (implement an S3/GCS StorageBackend for production)
STORAGE_BACKEND=local
UPLOAD_FOLDER=
MAX_CONTENT_LENGTH=8388608
IMAGE_MAX_DIMENSION=1600
IMAGE_QUALITY=82
# Set when files are served from a CDN/bucket instead of this API.
PUBLIC_MEDIA_BASE_URL=
# Acknowledges that UPLOAD_FOLDER is on a persistent volume. Only silences the
# "uploads are lost on redeploy" warning; it does not make storage durable.
UPLOADS_ARE_PERSISTENT=false

# --- Mail ------------------------------------------------------------------
MAIL_ENABLED=false
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@example.com
MAIL_SUPPRESS_SEND=true

# --- Security --------------------------------------------------------------
RATELIMIT_ENABLED=true
# memory:// counts per worker process, so N workers allow N times the limit.
# Point REDIS_URL at a Redis/Key Value instance for one shared counter;
# RATELIMIT_STORAGE_URI overrides it when set explicitly.
RATELIMIT_STORAGE_URI=
REDIS_URL=
RATELIMIT_DEFAULT=600 per hour
AUTH_RATELIMIT=10 per minute
MAX_FAILED_LOGIN_ATTEMPTS=10
PASSWORD_RESET_TOKEN_MINUTES=60
SEND_SECURE_HEADERS=true
# Strict-Transport-Security. Only sent over HTTPS. Defaults on in production.
ENABLE_HSTS=false
HSTS_MAX_AGE=31536000
# Raise over time. Lowering this is only acceptable in the test config.
PASSWORD_HASH_METHOD=pbkdf2:sha256:600000

# --- Reverse proxy ---------------------------------------------------------
# Enable behind a load balancer that terminates TLS (Render, Heroku, nginx).
# Without it every request appears to come from the proxy, putting all clients
# in a single rate-limit bucket. Defaults on in production.
# Each value is the number of trusted proxies in front of the app; only set a
# header count you actually control, or clients can spoof it.
TRUST_PROXY_HEADERS=false
PROXY_FIX_FOR=1
PROXY_FIX_PROTO=1
PROXY_FIX_HOST=1
PROXY_FIX_PREFIX=0

# --- Pagination ------------------------------------------------------------
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# --- Deployment ------------------------------------------------------------
# Port to bind. Injected by the platform on Render; defaults to 8000.
PORT=
# Gunicorn (see gunicorn.conf.py). Workers default to 2-4 based on CPU count.
WEB_CONCURRENCY=2
GUNICORN_WORKER_CLASS=gthread
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
GUNICORN_LOG_LEVEL=info
# render_start.sh runs `flask db upgrade && flask post-deploy` before serving.
# Set false when migrations run from a pre-deploy command instead.
RUN_MIGRATIONS_ON_START=true

# --- First administrator ---------------------------------------------------
# `flask post-deploy` (and `flask bootstrap-admin`) creates this account when
# the database has no administrator yet, then does nothing on later runs. Only
# an admin can create another admin, so a fresh database needs this seed.
# Change the password after the first sign-in.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Hostel Administrator
BOOTSTRAP_ADMIN_DESIGNATION=Chief Warden
