# ---------------------------------------------------------------------------
# Hostel Management System - backend environment template
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# development | testing | production
FLASK_ENV=development
FLASK_APP=run.py

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-value
JWT_SECRET_KEY=replace-with-a-different-long-random-value

# --- Database --------------------------------------------------------------
# PostgreSQL (production). psycopg 3 driver:
# DATABASE_URL=postgresql+psycopg://hms_user:password@localhost:5432/hostel_db
# Plain postgres:// / postgresql:// URLs are auto-upgraded to psycopg.
# Leave unset to use the local SQLite file backend/hostel.db.
DATABASE_URL=
TEST_DATABASE_URL=sqlite:///:memory:
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- JWT -------------------------------------------------------------------
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=30

# --- CORS (comma separated frontend origins) -------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_BASE_URL=http://localhost:5173

# --- Uploads ---------------------------------------------------------------
# local | (implement an S3/GCS StorageBackend for production)
STORAGE_BACKEND=local
UPLOAD_FOLDER=
MAX_CONTENT_LENGTH=8388608
IMAGE_MAX_DIMENSION=1600
IMAGE_QUALITY=82
# Set when files are served from a CDN/bucket instead of this API.
PUBLIC_MEDIA_BASE_URL=

# --- Mail ------------------------------------------------------------------
MAIL_ENABLED=false
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@example.com
MAIL_SUPPRESS_SEND=true

# --- Security --------------------------------------------------------------
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_DEFAULT=600 per hour
AUTH_RATELIMIT=10 per minute
MAX_FAILED_LOGIN_ATTEMPTS=10
PASSWORD_RESET_TOKEN_MINUTES=60
SEND_SECURE_HEADERS=true

# --- Pagination ------------------------------------------------------------
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
